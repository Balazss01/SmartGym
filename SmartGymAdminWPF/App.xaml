        <!-- bi-tags-fill – Tagok sidebar ikon -->
        <Geometry x:Key="Icon.Tags">M2 2a1 1 0 0 1 1-1h4.586a1 1 0 0 1 .707.293l7 7a1 1 0 0 1 0 1.414l-4.586 4.586a1 1 0 0 1-1.414 0l-7-7A1 1 0 0 1 2 6.586zm3.5 3a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3M1.293 7.793A1 1 0 0 0 1 8.5v1.586l.006.042 6.195 6.195.908-.907L1.293 7.793z</Geometry>

