<Page x:Class="SmartGymAdminWPF.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      Background="{StaticResource BgBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ADMIN PANEL" Foreground="#00f5c4" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="Dashboard" FontSize="26" FontWeight="Bold" Foreground="#f0ede8"/>
                    <TextBlock x:Name="FrissitveText" Text="Utolsó frissítés: —" Foreground="#3a3a4a" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Frissítés" Width="120" Height="38"
                        Style="{StaticResource ModernButtonStyle}" Click="FrissitesButton_Click"/>
                <CheckBox x:Name="AutoRefreshCheckBox" Grid.Column="3" VerticalAlignment="Center"
                          Foreground="#4a4740" FontSize="13" Content="Auto refresh"
                          Checked="AutoRefreshCheckBox_Checked" Unchecked="AutoRefreshCheckBox_Unchecked"/>
            </Grid>

            <UniformGrid Grid.Row="2" Columns="4" Margin="-6,0">

                <Border Margin="6" Padding="22,18" CornerRadius="18" BorderBrush="#1f1f2e" BorderThickness="1" Background="#0f0f1a">
                    <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="10" HorizontalAlignment="Left" Margin="0,0,0,12" Background="#0d1f1c">
                            <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource Icon.People}"
                                      Fill="#f0ede8"
                                      Stretch="Uniform"/>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="Összes tag" Foreground="#3a3a4a" FontSize="12" Margin="0,0,0,4"/>
                        <TextBlock x:Name="OsszesTagText" Text="0" Foreground="#f0ede8" FontSize="32" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border Margin="6" Padding="22,18" CornerRadius="18" BorderBrush="#1f1f2e" BorderThickness="1" Background="#0f0f1a">
                    <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="10" HorizontalAlignment="Left" Margin="0,0,0,12" Background="#0d1f14">
                            <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource Icon.People}"
                                      Fill="#00f5c4"
                                      Stretch="Uniform"/>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="Aktív tag" Foreground="#3a3a4a" FontSize="12" Margin="0,0,0,4"/>
                        <TextBlock x:Name="AktivTagText" Text="0" Foreground="#00f5c4" FontSize="32" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border Margin="6" Padding="22,18" CornerRadius="18" BorderBrush="#1f1f2e" BorderThickness="1" Background="#0f0f1a">
                    <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="10" HorizontalAlignment="Left" Margin="0,0,0,12" Background="#13101f">
                            <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource Icon.People}"
                                      Fill="#f0ede8"
                                      Stretch="Uniform"/>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="Összes bérlet" Foreground="#3a3a4a" FontSize="12" Margin="0,0,0,4"/>
                        <TextBlock x:Name="OsszesBerletText" Text="0" Foreground="#f0ede8" FontSize="32" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border Margin="6" Padding="22,18" CornerRadius="18" BorderBrush="#1f1f2e" BorderThickness="1" Background="#0f0f1a">
                    <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="10" HorizontalAlignment="Left" Margin="0,0,0,12" Background="#13101f">
                            <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource Icon.People}"
                                      Fill="#7c6af8"
                                      Stretch="Uniform"/>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="Aktív bérlet" Foreground="#3a3a4a" FontSize="12" Margin="0,0,0,4"/>
                        <TextBlock x:Name="AktivBerletText" Text="0" Foreground="#7c6af8" FontSize="32" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border Margin="6" Padding="22,18" CornerRadius="18" BorderBrush="#1f1f2e" BorderThickness="1" Background="#0f0f1a">
                    <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="10" HorizontalAlignment="Left" Margin="0,0,0,12" Background="#13101f">
                            <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource Icon.People}"
                                      Fill="#a78bfa"
                                      Stretch="Uniform"/>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="Előre megvásárolt" Foreground="#3a3a4a" FontSize="12" Margin="0,0,0,4"/>
                        <TextBlock x:Name="EloreMegvasaroltBerletText" Text="0" Foreground="#a78bfa" FontSize="32" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border Margin="6" Padding="22,18" CornerRadius="18" BorderBrush="#1f1f2e" BorderThickness="1" Background="#0f0f1a">
                    <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="10" HorizontalAlignment="Left" Margin="0,0,0,12" Background="#0d1f14">
                            <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource Icon.People}"
                                      Fill="#4ade80"
                                      Stretch="Uniform"/>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="Mai belépések" Foreground="#3a3a4a" FontSize="12" Margin="0,0,0,4"/>
                        <TextBlock x:Name="MaiBelepesText" Text="0" Foreground="#4ade80" FontSize="32" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border Margin="6" Padding="22,18" CornerRadius="18" BorderBrush="#1f1f2e" BorderThickness="1" Background="#0f0f1a">
                    <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="10" HorizontalAlignment="Left" Margin="0,0,0,12" Background="#1f1508">
                            <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource Icon.People}"
                                      Fill="#fbbf24"
                                      Stretch="Uniform"/>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="Jelenleg bent" Foreground="#3a3a4a" FontSize="12" Margin="0,0,0,4"/>
                        <TextBlock x:Name="BentLevokText" Text="0" Foreground="#fbbf24" FontSize="32" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border Margin="6" Padding="22,18" CornerRadius="18" BorderBrush="#1f1f2e" BorderThickness="1" Background="#0f0f1a">
                    <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="10" HorizontalAlignment="Left" Margin="0,0,0,12" Background="#13101f">
                            <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource Icon.People}"
                                      Fill="#7c6af8"
                                      Stretch="Uniform"/>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="Aktív foglalások" Foreground="#3a3a4a" FontSize="12" Margin="0,0,0,4"/>
                        <TextBlock x:Name="SzekrenyFoglalasText" Text="0" Foreground="#7c6af8" FontSize="32" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="4" Margin="-6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="#0f0f1a" CornerRadius="18" Padding="22" BorderBrush="#1f1f2e" BorderThickness="1" Margin="6,0">
                    <StackPanel>
                        <TextBlock Text="HETI BELÉPÉSEK" Foreground="#00f5c4" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Belépések az elmúlt 7 napban" Foreground="#f0ede8" FontSize="16" FontWeight="Bold" Margin="0,0,0,18"/>
                        <ItemsControl x:Name="HetiBelepesekItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Datum}" Foreground="#4a4740" FontSize="12" VerticalAlignment="Center"/>
                                        <ProgressBar Grid.Column="1" Height="6" Margin="10,0" Minimum="0"
                                                     Maximum="{Binding MaxErtek}" Value="{Binding Darab}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Darab}" Foreground="#f0ede8" FontSize="12"
                                                   FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#0f0f1a" CornerRadius="18" Padding="22" BorderBrush="#1f1f2e" BorderThickness="1" Margin="6,0">
                    <StackPanel>
                        <TextBlock Text="BÉRLET MEGOSZLÁS" Foreground="#00f5c4" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Státusz szerinti bontás" Foreground="#f0ede8" FontSize="16" FontWeight="Bold" Margin="0,0,0,22"/>
                        <TextBlock Text="AKTÍV" Foreground="#3a3a4a" FontSize="10" FontWeight="SemiBold"/>
                        <ProgressBar x:Name="AktivBerletProgress" Height="6" Margin="0,6,0,4" Minimum="0"/>
                        <TextBlock x:Name="AktivBerletAranyText" Foreground="#00f5c4" FontSize="12" Margin="0,0,0,18"/>
                        <TextBlock Text="ELŐRE MEGVÁSÁROLT" Foreground="#3a3a4a" FontSize="10" FontWeight="SemiBold"/>
                        <ProgressBar x:Name="EloreMegvasaroltProgress" Height="6" Margin="0,6,0,4" Minimum="0"/>
                        <TextBlock x:Name="EloreMegvasaroltAranyText" Foreground="#7c6af8" FontSize="12" Margin="0,0,0,18"/>
                        <TextBlock Text="LEJÁRT / INAKTÍV" Foreground="#3a3a4a" FontSize="10" FontWeight="SemiBold"/>
                        <ProgressBar x:Name="LejartBerletProgress" Height="6" Margin="0,6,0,4" Minimum="0"/>
                        <TextBlock x:Name="LejartBerletAranyText" Foreground="#f87171" FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="6" Background="#0f0f1a" CornerRadius="18" Padding="22" BorderBrush="#1f1f2e" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="JELENLÉT" Foreground="#00f5c4" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,3"/>
                            <TextBlock Text="Jelenleg bent lévők" Foreground="#f0ede8" FontSize="16" FontWeight="Bold"/>
                        </StackPanel>
                        <Border Background="#0d1f0a" BorderBrush="#1a3a14" BorderThickness="1" CornerRadius="20"
                                Padding="10,4" Margin="14,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#4ade80" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="ÉLŐ" Foreground="#4ade80" FontSize="10" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <DataGrid x:Name="BentLevokGrid" Style="{StaticResource ModernDataGridStyle}"
                              AutoGenerateColumns="False" Height="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="BELÉPÉS ID" Binding="{Binding BelepesId}" Width="*"/>
                            <DataGridTextColumn Header="TAG ID"     Binding="{Binding TagId}"     Width="*"/>
                            <DataGridTextColumn Header="NÉV"        Binding="{Binding TeljesNev}" Width="2*"/>
                            <DataGridTextColumn Header="BELÉPETT"
                                                Binding="{Binding BelepesIdopont, StringFormat=yyyy.MM.dd HH:mm}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Grid.Row="8" Background="#0f0f1a" CornerRadius="18" Padding="22" BorderBrush="#1f1f2e" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="AKTIVITÁS" Foreground="#00f5c4" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,3"/>
                            <TextBlock Text="Belépések a mai napon" Foreground="#f0ede8" FontSize="16" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock x:Name="OsszesBelepesHintText" Grid.Column="1"
                                   Text="0 belépés ma" Foreground="#4a4740" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>

                    <lvc:CartesianChart x:Name="AktivitasChart"
                                        Height="220"
                                        Series="{Binding ChartSeries}"
                                        XAxes="{Binding ChartXAxes}"
                                        YAxes="{Binding ChartYAxes}"
                                        Background="Transparent"
                                        TooltipPosition="Top"/>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#0a0a12" CornerRadius="10" Padding="14,10" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="MAI BELÉPÉSEK" Foreground="#3a3a4a" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock x:Name="AtlagBentletText" Text="0 fő" Foreground="#00f5c4" FontSize="20" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#0a0a12" CornerRadius="10" Padding="14,10" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="CSÚCSIDŐ" Foreground="#3a3a4a" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock x:Name="MaxBentletText" Text="—" Foreground="#fbbf24" FontSize="20" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#0a0a12" CornerRadius="10" Padding="14,10" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="LEGUTÓBBI" Foreground="#3a3a4a" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock x:Name="FolyamatbanText" Text="—" Foreground="#7c6af8" FontSize="20" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</Page>