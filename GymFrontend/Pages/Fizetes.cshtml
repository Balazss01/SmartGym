@page "{id:int?}"
@model GymFrontend.Pages.FizetesModel

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

<style>
    .fizetes-wrapper {
        max-width: 540px;
        margin: 0 auto;
        padding: 0.5rem 0 2rem;
    }

    .fizetes-fejlec {
        margin-bottom: 28px;
    }

    .fizetes-cimke {
        font-size: 11px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #00f5c4;
        margin-bottom: 8px;
        display: block;
    }

    .fizetes-cim {
        font-family: 'Syne', sans-serif;
        font-size: 26px;
        font-weight: 700;
        color: #f0ede8;
        margin: 0;
    }

    /* Bérlet összegzés kártya */
    .osszegzes-kartya {
        background: linear-gradient(135deg, rgba(0,245,196,0.08), rgba(124,106,248,0.08));
        border: 0.5px solid rgba(0,245,196,0.25);
        border-radius: 18px;
        padding: 22px;
        margin-bottom: 18px;
    }

    .osszegzes-fej {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 14px;
    }

    .osszegzes-nev {
        font-family: 'Syne', sans-serif;
        font-size: 18px;
        font-weight: 700;
        color: #f0ede8;
        margin: 0 0 4px;
    }

    .osszegzes-idotartam {
        font-size: 12.5px;
        color: rgba(240,237,232,0.5);
    }

    .osszegzes-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: rgba(0,245,196,0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #00f5c4;
        font-size: 16px;
        flex-shrink: 0;
    }

    .osszegzes-sor {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 0;
        border-top: 0.5px solid rgba(255,255,255,0.07);
        font-size: 13px;
        color: rgba(240,237,232,0.6);
    }

        .osszegzes-sor.fo {
            font-family: 'Syne', sans-serif;
            font-size: 17px;
            color: #f0ede8;
            font-weight: 700;
            padding-top: 14px;
        }

    /* Fizetési kártya forma */
    .fizetes-kartya {
        background: rgba(255,255,255,0.04);
        border: 0.5px solid rgba(255,255,255,0.08);
        border-radius: 18px;
        padding: 22px;
        margin-bottom: 14px;
    }

    .szekcio-cim {
        font-size: 10px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: rgba(240,237,232,0.5);
        margin-bottom: 16px;
        font-family: 'Syne', sans-serif;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .mezo-sor {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-bottom: 12px;
    }

        .mezo-sor.teljes {
            grid-template-columns: 1fr;
        }

    .mezo-csoport {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .mezo-cimke {
        font-size: 11px;
        color: rgba(240,237,232,0.5);
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .mezo-input {
        background: rgba(255,255,255,0.06);
        border: 0.5px solid rgba(255,255,255,0.08);
        border-radius: 10px;
        color: #f0ede8;
        font-family: 'DM Sans', sans-serif;
        font-size: 13.5px;
        padding: 10px 12px;
        outline: none;
        transition: all 0.2s;
        width: 100%;
        letter-spacing: 0.02em;
    }

        .mezo-input:focus {
            border-color: rgba(0,245,196,0.4);
            background: rgba(0,245,196,0.05);
            box-shadow: 0 0 0 3px rgba(0,245,196,0.06);
        }

        .mezo-input::placeholder {
            color: rgba(240,237,232,0.25);
        }

    /* Gombok */
    .fizetes-gomb {
        width: 100%;
        padding: 13px;
        border-radius: 10px;
        border: none;
        background: linear-gradient(135deg, #00f5c4, #7c6af8);
        color: #09090f;
        font-family: 'Syne', sans-serif;
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 0.04em;
        cursor: pointer;
        transition: opacity 0.2s, transform 0.15s;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

        .fizetes-gomb:hover {
            opacity: 0.88;
            transform: translateY(-1px);
        }

        .fizetes-gomb:active {
            transform: scale(0.98);
        }

    .megse-gomb {
        width: 100%;
        padding: 11px;
        border-radius: 10px;
        border: 0.5px solid rgba(255,255,255,0.1);
        background: transparent;
        color: rgba(240,237,232,0.6);
        font-family: 'DM Sans', sans-serif;
        font-size: 13px;
        cursor: pointer;
        text-align: center;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        transition: all 0.2s;
    }

        .megse-gomb:hover {
            border-color: rgba(255,255,255,0.2);
            color: #f0ede8;
            background: rgba(255,255,255,0.04);
        }

    .biztonsagi-info {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        font-size: 11px;
        color: rgba(240,237,232,0.4);
        margin-top: 14px;
    }

    .hibak-listaja {
        font-size: 12.5px;
        color: #f87171;
        margin-bottom: 14px;
        background: rgba(248,113,113,0.08);
        border: 0.5px solid rgba(248,113,113,0.2);
        border-radius: 10px;
        padding: 10px 14px;
    }

        .hibak-listaja ul {
            margin: 0;
            padding-left: 18px;
        }
</style>

<div class="fizetes-wrapper">

    <div class="fizetes-fejlec">
        <span class="fizetes-cimke">Fizetés</span>
        <h1 class="fizetes-cim">Bérlet vásárlása</h1>
    </div>

    @if (Model.Berlet != null)
    {
        var perNap = Model.Berlet.IdotartamNapok > 0
            ? (int)Math.Round((double)Model.Berlet.Ar / Model.Berlet.IdotartamNapok)
            : (int)Model.Berlet.Ar;

        <!-- Bérlet összegzés -->
        <div class="osszegzes-kartya">
            <div class="osszegzes-fej">
                <div>
                    <h3 class="osszegzes-nev">@Model.Berlet.Megnevezes</h3>
                    <div class="osszegzes-idotartam">
                        <i class="bi bi-calendar3"></i>
                        @Model.Berlet.IdotartamNapok napos bérlet
                    </div>
                </div>
                <div class="osszegzes-icon">
                    <i class="bi bi-bag-check-fill"></i>
                </div>
            </div>

            <div class="osszegzes-sor">
                <span>Egy napra vetítve</span>
                <span>≈ @perNap Ft</span>
            </div>

            <div class="osszegzes-sor fo">
                <span>Fizetendő összeg</span>
                <span>@Model.Berlet.Ar.ToString("N0") Ft</span>
            </div>
        </div>
    }

    <form method="post">
        <input type="hidden" asp-for="Id" />

        <!-- Validációs hibák -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="hibak-listaja">
                <ul>
                    @foreach (var hiba in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@hiba.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <!-- Kártya adatok form -->
        <div class="fizetes-kartya">
            <div class="szekcio-cim">
                <i class="bi bi-credit-card-2-front"></i> Bankkártya adatok
            </div>

            <div class="mezo-sor teljes">
                <div class="mezo-csoport">
                    <label class="mezo-cimke" asp-for="KartyaTulajdonos">
                        <i class="bi bi-person"></i> Kártyabirtokos neve
                    </label>
                    <input asp-for="KartyaTulajdonos" class="mezo-input" placeholder="KISS ANNA" autocomplete="cc-name" />
                </div>
            </div>

            <div class="mezo-sor teljes">
                <div class="mezo-csoport">
                    <label class="mezo-cimke" asp-for="Kartyaszam">
                        <i class="bi bi-credit-card"></i> Kártyaszám
                    </label>
                    <input asp-for="Kartyaszam" id="kartyaszamInput" class="mezo-input" placeholder="1234 5678 9012 3456" autocomplete="cc-number" inputmode="numeric" maxlength="19" />
                </div>
            </div>

            <div class="mezo-sor">
                <div class="mezo-csoport">
                    <label class="mezo-cimke" asp-for="Lejarat">
                        <i class="bi bi-calendar"></i> Lejárati dátum
                    </label>
                    <input asp-for="Lejarat" id="lejaratInput" class="mezo-input" placeholder="HH/ÉÉ" autocomplete="cc-exp" inputmode="numeric" maxlength="5" />
                </div>
                <div class="mezo-csoport">
                    <label class="mezo-cimke" asp-for="Cvc">
                        <i class="bi bi-shield-lock"></i> CVC
                    </label>
                    <input asp-for="Cvc" class="mezo-input" placeholder="123" autocomplete="cc-csc" inputmode="numeric" maxlength="3" />
                </div>
            </div>
        </div>

        <button type="submit" class="fizetes-gomb">
            <i class="bi bi-lock-fill"></i>
            Fizetés
            @if (Model.Berlet != null)
            {
                <span>· @Model.Berlet.Ar.ToString("N0") Ft</span>
            }
        </button>

        <a href="/Berletek" class="megse-gomb">
            <i class="bi bi-arrow-left" style="font-size:13px"></i> Mégse
        </a>

        <div class="biztonsagi-info">
            <i class="bi bi-shield-check"></i>
            Biztonságos fizetés (teszt környezet)
        </div>

    </form>

</div>

<script>
    // Kártyaszám: csoportosítás 4-esével
    const kartyaszamInput = document.getElementById('kartyaszamInput');

    kartyaszamInput.addEventListener('input', function(e) {
        let v = e.target.value.replace(/\D/g, '').substring(0, 16);
        e.target.value = v.match(/.{1,4}/g)?.join(' ') ?? '';
    });

    // Lejárat: HH/ÉÉ automatikus formázás
    const lejaratInput = document.getElementById('lejaratInput');

    lejaratInput.addEventListener('input', function(e) {
        let v = e.target.value.replace(/\D/g, '').substring(0, 4);
        if (v.length >= 3) {
            v = v.substring(0, 2) + '/' + v.substring(2);
        }
        e.target.value = v;
    });
</script>
