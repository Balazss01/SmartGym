<!-- NAGYITO -->
<div class="nagyito" id="nagyito" aria-hidden="true">
    <button class="nagyito-gomb nagyito-bezar" id="nagyito-bezar" aria-label="Bezárás">
        <i class="bi bi-x-lg"></i>
    </button>
    <button class="nagyito-gomb nagyito-elozo" id="nagyito-elozo" aria-label="Előző">
        <i class="bi bi-chevron-left"></i>
    </button>
    <button class="nagyito-gomb nagyito-kovetkezo" id="nagyito-kovetkezo" aria-label="Következő">
        <i class="bi bi-chevron-right"></i>
    </button>

    <div class="nagyito-tartalom">
        <div class="nagyito-kep-keret">
            <img id="nagyito-kep" src="" alt="" />
        </div>
        <div class="nagyito-felirat">
            <div class="nagyito-cim" id="nagyito-cim"></div>
            <div class="nagyito-leiras" id="nagyito-leiras"></div>
            <div class="nagyito-szamlalo" id="nagyito-szamlalo"></div>
        </div>
    </div>
</div>

<script>
    (function () {
        // ── SZURES ──
        const szuroGombok = document.querySelectorAll('.szuro-gomb');
        const kepDobozok  = document.querySelectorAll('.kep-doboz');

        szuroGombok.forEach(gomb => {
            gomb.addEventListener('click', () => {
                szuroGombok.forEach(g => g.classList.remove('aktiv'));
                gomb.classList.add('aktiv');

                const szuro = gomb.dataset.szuro;
                kepDobozok.forEach(doboz => {
                    const megjelenit = (szuro === 'osszes' || doboz.dataset.kategoria === szuro);
                    doboz.classList.toggle('rejtett', !megjelenit);
                });
            });
        });

        // ── NAGYITO ──
        const nagyito          = document.getElementById('nagyito');
        const nagyitoKep       = document.getElementById('nagyito-kep');
        const nagyitoCim       = document.getElementById('nagyito-cim');
        const nagyitoLeiras    = document.getElementById('nagyito-leiras');
        const nagyitoSzamlalo  = document.getElementById('nagyito-szamlalo');
        const nagyitoBezar     = document.getElementById('nagyito-bezar');
        const nagyitoElozo     = document.getElementById('nagyito-elozo');
        const nagyitoKovetkezo = document.getElementById('nagyito-kovetkezo');

        const adatok = Array.from(kepDobozok).map(doboz => ({
            forras: doboz.querySelector('img').src,
            alt:    doboz.querySelector('img').alt,
            cim:    doboz.querySelector('.kep-cim').textContent,
            leiras: doboz.querySelector('.kep-leiras').textContent
        }));

        let aktualis = 0;

        function lathatoSorszamok() {
            return Array.from(kepDobozok)
                .map((doboz, sorszam) => ({ doboz, sorszam }))
                .filter(x => !x.doboz.classList.contains('rejtett'))
                .map(x => x.sorszam);
        }

        function frissit() {
            const adat = adatok[aktualis];
            nagyitoKep.src = adat.forras;
            nagyitoKep.alt = adat.alt;
            nagyitoCim.textContent = adat.cim;
            nagyitoLeiras.textContent = adat.leiras;

            const lathato = lathatoSorszamok();
            const pozicio = lathato.indexOf(aktualis) + 1;
            nagyitoSzamlalo.textContent = pozicio + ' / ' + lathato.length;
        }

        function megnyit(sorszam) {
            aktualis = sorszam;
            frissit();
            nagyito.classList.add('aktiv');
            nagyito.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
        }

        function bezar() {
            nagyito.classList.remove('aktiv');
            nagyito.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
        }

        function lepes(irany) {
            const lathato = lathatoSorszamok();
            if (lathato.length === 0) return;
            let pozicio = lathato.indexOf(aktualis);
            pozicio = (pozicio + irany + lathato.length) % lathato.length;
            aktualis = lathato[pozicio];
            frissit();
        }

        kepDobozok.forEach((doboz, sorszam) => {
            doboz.addEventListener('click', () => megnyit(sorszam));
        });

        nagyitoBezar.addEventListener('click', bezar);
        nagyitoElozo.addEventListener('click', () => lepes(-1));
        nagyitoKovetkezo.addEventListener('click', () => lepes(1));

        nagyito.addEventListener('click', (esemeny) => {
            if (esemeny.target === nagyito) bezar();
        });

        document.addEventListener('keydown', (esemeny) => {
            if (!nagyito.classList.contains('aktiv')) return;
            if (esemeny.key === 'Escape')     bezar();
            if (esemeny.key === 'ArrowLeft')  lepes(-1);
            if (esemeny.key === 'ArrowRight') lepes(1);
        });

        // ── BELEPESI ANIMACIO GORGETESKOR ──
        if ('IntersectionObserver' in window) {
            const figyelo = new IntersectionObserver((bejegyzesek) => {
                bejegyzesek.forEach(bej => {
                    if (bej.isIntersecting) {
                        bej.target.style.opacity = '1';
                        bej.target.style.transform = 'translateY(0)';
                        figyelo.unobserve(bej.target);
                    }
                });
            }, { threshold: 0.08 });

            kepDobozok.forEach((doboz, sorszam) => {
                doboz.style.opacity = '0';
                doboz.style.transform = 'translateY(20px)';
                doboz.style.transition = 'opacity .55s ease ' + (sorszam * 0.04) + 's, transform .55s ease ' + (sorszam * 0.04) + 's, border-color .3s, box-shadow .3s';
                figyelo.observe(doboz);
            });
        }
    })();
</script>
