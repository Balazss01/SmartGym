@page
@model GymFrontend.Pages.GaleriaModel

<style>
    /* ── OLDAL FEJLEC ── */
    .galeria-keret {
        max-width: 1280px;
        margin: 0 auto;
    }

    .oldal-fejlec {
        margin-bottom: 28px;
    }

    .oldal-cimke {
        font-size: 11px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #00f5c4;
        margin-bottom: 8px;
        display: inline-flex;
        align-items: center;
        gap: 7px;
    }

    .oldal-cimke-pont {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #00f5c4;
        animation: villog 2s infinite;
    }

    @@keyframes villog {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.3; }
    }

    .oldal-cim {
        font-family: 'Syne', sans-serif;
        font-size: clamp(1.8rem, 4vw, 2.4rem);
        font-weight: 700;
        color: #f0ede8;
        margin: 0 0 10px 0;
        line-height: 1.1;
    }

        .oldal-cim .kiemelt {
            background: linear-gradient(135deg, #00f5c4, #7c6af8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

    .oldal-leiras {
        font-size: 14px;
        color: rgba(240,237,232,0.5);
        line-height: 1.7;
        max-width: 580px;
    }

    /* ── SZURO SAV ── */
    .szuro-sav {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 24px;
        padding-bottom: 24px;
        border-bottom: 0.5px solid rgba(255,255,255,0.08);
    }

    .szuro-gomb {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 16px;
        background: rgba(255,255,255,0.04);
        border: 0.5px solid rgba(255,255,255,0.08);
        border-radius: 20px;
        color: rgba(240,237,232,0.7);
        font-family: 'DM Sans', sans-serif;
        font-size: 12.5px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
    }

        .szuro-gomb:hover {
            background: rgba(255,255,255,0.07);
            border-color: rgba(255,255,255,0.18);
            color: #f0ede8;
        }

        .szuro-gomb.aktiv {
            background: rgba(0,245,196,0.1);
            border-color: rgba(0,245,196,0.3);
            color: #00f5c4;
        }

    .szuro-gomb i {
        font-size: 13px;
    }

    /* ── GALERIA RACS ── */
    .galeria-racs {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        grid-auto-rows: 220px;
        gap: 14px;
    }

    .kep-doboz {
        position: relative;
        overflow: hidden;
        border-radius: 16px;
        cursor: pointer;
        background: rgba(255,255,255,0.04);
        border: 0.5px solid rgba(255,255,255,0.08);
        transition: all 0.3s cubic-bezier(.4,0,.2,1);
    }

        .kep-doboz.nagy {
            grid-column: span 2;
            grid-row: span 2;
        }

        .kep-doboz.kozepes {
            grid-row: span 2;
        }

        .kep-doboz::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg,
                transparent 40%,
                rgba(9,9,15,0.4) 70%,
                rgba(9,9,15,0.92) 100%);
            opacity: 0.85;
            transition: opacity 0.3s;
            pointer-events: none;
            z-index: 1;
        }

        .kep-doboz img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s cubic-bezier(.4,0,.2,1), filter 0.3s;
            filter: brightness(0.9) saturate(0.95);
        }

        .kep-doboz:hover {
            border-color: rgba(0,245,196,0.3);
            transform: translateY(-3px);
            box-shadow: 0 12px 32px rgba(0,0,0,0.4),
                        0 0 0 1px rgba(0,245,196,0.15);
        }

            .kep-doboz:hover::after {
                opacity: 1;
            }

            .kep-doboz:hover img {
                transform: scale(1.06);
                filter: brightness(1) saturate(1.05);
            }

    .kep-infok {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        padding: 18px 20px;
        z-index: 2;
        transform: translateY(8px);
        opacity: 0.92;
        transition: all 0.3s;
    }

    .kep-doboz:hover .kep-infok {
        transform: translateY(0);
        opacity: 1;
    }

    .kep-cimke {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 10px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #00f5c4;
        background: rgba(0,245,196,0.12);
        border: 0.5px solid rgba(0,245,196,0.25);
        border-radius: 12px;
        padding: 3px 10px;
        margin-bottom: 8px;
    }

        .kep-cimke.lila {
            color: #7c6af8;
            background: rgba(124,106,248,0.12);
            border-color: rgba(124,106,248,0.25);
        }

        .kep-cimke.zold {
            color: #4ade80;
            background: rgba(74,222,128,0.12);
            border-color: rgba(74,222,128,0.25);
        }

    .kep-cim {
        font-family: 'Syne', sans-serif;
        font-size: 17px;
        font-weight: 700;
        color: #f0ede8;
        margin-bottom: 4px;
        line-height: 1.2;
    }

    .kep-doboz.nagy .kep-cim {
        font-size: 22px;
    }

    .kep-leiras {
        font-size: 12.5px;
        color: rgba(240,237,232,0.6);
        line-height: 1.5;
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.4s, margin 0.4s;
    }

    .kep-doboz:hover .kep-leiras {
        max-height: 60px;
        margin-top: 2px;
    }

    .kep-nagyitas {
        position: absolute;
        top: 14px;
        right: 14px;
        width: 34px;
        height: 34px;
        border-radius: 10px;
        background: rgba(9,9,15,0.7);
        backdrop-filter: blur(8px);
        border: 0.5px solid rgba(255,255,255,0.15);
        color: #f0ede8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        opacity: 0;
        transform: translateY(-6px);
        transition: all 0.3s;
        z-index: 2;
    }

    .kep-doboz:hover .kep-nagyitas {
        opacity: 1;
        transform: translateY(0);
    }

    .kep-doboz.rejtett { display: none; }

    /* ── NAGYITO ── */
    .nagyito {
        position: fixed;
        inset: 0;
        background: rgba(9,9,15,0.92);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 2000;
        padding: 40px;
        opacity: 0;
        transition: opacity 0.3s;
    }

        .nagyito.aktiv {
            display: flex;
            opacity: 1;
        }

    .nagyito-tartalom {
        max-width: 1100px;
        width: 100%;
        text-align: center;
        position: relative;
    }

    .nagyito-kep-keret {
        background: rgba(255,255,255,0.04);
        border: 0.5px solid rgba(255,255,255,0.1);
        border-radius: 16px;
        padding: 8px;
        overflow: hidden;
    }

    #nagyito-kep {
        max-height: 75vh;
        max-width: 100%;
        width: auto;
        height: auto;
        margin: 0 auto;
        border-radius: 12px;
        display: block;
    }

    .nagyito-felirat {
        margin-top: 18px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
    }

    .nagyito-cim {
        font-family: 'Syne', sans-serif;
        font-size: 18px;
        color: #f0ede8;
        font-weight: 600;
    }

    .nagyito-leiras {
        font-size: 13px;
        color: rgba(240,237,232,0.55);
        max-width: 600px;
    }

    .nagyito-szamlalo {
        margin-top: 8px;
        font-size: 11px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: rgba(240,237,232,0.35);
    }

    .nagyito-gomb {
        position: absolute;
        background: rgba(255,255,255,0.05);
        backdrop-filter: blur(8px);
        border: 0.5px solid rgba(255,255,255,0.12);
        color: #f0ede8;
        font-size: 18px;
        width: 46px;
        height: 46px;
        border-radius: 12px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        z-index: 2;
    }

        .nagyito-gomb:hover {
            background: rgba(0,245,196,0.12);
            border-color: rgba(0,245,196,0.3);
            color: #00f5c4;
        }

    .nagyito-bezar {
        top: 24px;
        right: 24px;
        position: fixed;
    }

    .nagyito-elozo { left: -70px; top: 50%; transform: translateY(-50%); }
    .nagyito-kovetkezo { right: -70px; top: 50%; transform: translateY(-50%); }

    /* ── RESZPONZIV ── */
    @@media (max-width: 1024px) {
        .galeria-racs {
            grid-template-columns: repeat(2, 1fr);
        }

        .kep-doboz.nagy {
            grid-column: span 2;
            grid-row: span 1;
        }

        .kep-doboz.kozepes {
            grid-row: span 1;
        }

        .nagyito-elozo, .nagyito-kovetkezo {
            position: fixed;
            top: auto;
            bottom: 30px;
            transform: none;
        }

            .nagyito-elozo { left: 30%; }
            .nagyito-kovetkezo { right: 30%; }
    }

    @@media (max-width: 640px) {
        .galeria-racs {
            grid-template-columns: 1fr;
            grid-auto-rows: 240px;
        }

        .kep-doboz.nagy { grid-column: span 1; }

        .kep-infok { opacity: 1; transform: translateY(0); }
        .kep-leiras { max-height: 60px; margin-top: 2px; }

        .nagyito { padding: 16px; }

        .nagyito-elozo { left: 20px; }
        .nagyito-kovetkezo { right: 20px; }
    }
</style>

